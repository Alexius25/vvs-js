{
  "compilerOptions": {
    "target": "esNext",
    "moduleResolution": "node",
    "module": "es2020",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist/esm",
    "declaration": true,
    "declarationDir": "dist/esm"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
