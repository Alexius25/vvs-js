{
  "name": "@alexius25/vvs-js",
  "version": "1.0.0",
  "description": "An unofficial JavaScript library for the Verkehrsverbund Stuttgart API",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build:esm": "tsc --project tsconfig.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "test:icons": "tsx tests/test_icons.ts",
    "test:livePos": "tsx tests/test_livePos.ts",
    "test:stationCompletion": "tsx tests/test_stationCompletion.ts",
    "test:departures": "tsx tests/test_departure.ts",
    "test": "npm run test:icons && npm run test:livePos && npm run test:stationCompletion && npm run test:departures"
  },
  "keywords": [
    "vvs",
    "javascript",
    "öpnv",
    "public transport"
  ],
  "author": "Alexius25",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "axios": "^1.13.5",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/xmldom": "^0.1.34",
    "csv-parser": "^3.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./enums": {
      "import": "./dist/esm/enums/index.js",
      "require": "./dist/cjs/enums/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexius25/vvs-js.git"
  }
}
